ather than no argument, and the test does what it says.",{"type":9,"tag":10,"props":783,"children":784},{},[785,787,793,795,801,803,809,811,817,818,824],{"type":14,"value":786},"The same failure hits every comparison. If ",{"type":9,"tag":47,"props":788,"children":790},{"className":789},[],[791],{"type":14,"value":792},"NAME",{"type":14,"value":794}," is unset, ",{"type":9,"tag":47,"props":796,"children":798},{"className":797},[],[799],{"type":14,"value":800},"[ $NAME = \"Ada\" ]",{"type":14,"value":802}," becomes ",{"type":9,"tag":47,"props":804,"children":806},{"className":805},[],[807],{"type":14,"value":808},"[ = \"Ada\" ]",{"type":14,"value":810}," — a syntax error, from a line that looks fine. ",{"type":9,"tag":47,"props":812,"children":814},{"className":813},[],[815],{"type":14,"value":816},"[ \"$NAME\" = \"Ada\" ]",{"type":14,"value":802},{"type":9,"tag":47,"props":819,"children":821},{"className":820},[],[822],{"type":14,"value":823},"[ \"\" = \"Ada\" ]",{"type":14,"value":825},", which is simply false.",{"type":9,"tag":10,"props":827,"children":828},{},[829,831,837,839,845],{"type":14,"value":830},"An older trick you will still meet in the wild prefixes both sides with a character: ",{"type":9,"tag":47,"props":832,"children":834},{"className":833},[],[835],{"type":14,"value":836},"[ \"x$NAME\" = \"xAda\" ]",{"type":14,"value":838},". It solves the same problem for shells so old they mishandled a leading ",{"type":9,"tag":47,"props":840,"children":842},{"className":841},[],[843],{"type":14,"value":844},"-",{"type":14,"value":846}," in the value. Quoting is the modern answer.\n::",{"data":848,"body":849},{},{"type":6,"children":850},[851,860,869,882,891,926,952,961],{"type":9,"tag":42,"props":852,"children":854},{"id":853},"if",[855],{"type":9,"tag":47,"props":856,"children":858},{"className":857},[],[859],{"type":14,"value":853},{"type":9,"tag":83,"props":861,"children":864},{"className":862,"code":863,"language":14},[86],"if [ -f \"$CONFIG\" ]\nthen\n  ech